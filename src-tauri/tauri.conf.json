{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plumbob Launcher",
  "version": "0.1.0",
  "identifier": "io.github.eriikp4.plumbob-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Plumbob Launcher", "width": 1200, "height": 796, "minWidth": 1200, "minHeight": 796, "dragDropEnabled": false, "backgroundColor": "#130f1c", "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection" }
    ],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": [] } }
  },
  "bundle": { "active": true, "publisher": "EriikP4", "homepage": "https://github.com/EriikP4/plumbob-launcher", "targets": ["nsis"], "icon": ["icons/icon.ico"], "windows": { "nsis": { "installerIcon": "icons/setup.ico", "languages": ["English", "Spanish"], "displayLanguageSelector": true } } }
}
